{
  "name": "mermaidia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "NODE_ENV=production node dist/server/index.js",
    "doctor": "tsx scripts/doctor.ts",
    "assets:build": "tsx scripts/build-assets.ts",
    "assets:validate": "tsx scripts/validate-assets.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:voice:live": "tsx scripts/voice-live.ts",
    "verify": "npm run typecheck && npm run lint && npm run assets:validate && npm run content:validate && npm test && npm run build && npm run test:e2e",
    "build:test": "vite build --mode test --outDir artifacts/test-client",
    "serve:test": "NODE_ENV=production STATIC_DIR=artifacts/test-client PORT=5174 APP_ORIGIN=http://localhost:5174 tsx server/index.ts",
    "test:performance": "tsx scripts/performance.ts",
    "test:release": "tsx scripts/release-audit.ts",
    "narration:build": "tsx scripts/narration-build.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "openai": "7.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
