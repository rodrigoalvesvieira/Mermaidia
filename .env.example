# Server only. Local keyboard/touch/narration play needs no key.
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
APP_ORIGIN=http://localhost:5173
PORT=5173
# Explicit adult/synthetic development testing only. Does not enable child audio.
ALLOW_ADULT_VOICE_DEV=false
LIVE_AUDIO_TEST=0
VOICE_FIXTURE_RUN=false
# Optional authoring path override:
# BLENDER_BIN=/path/to/blender
